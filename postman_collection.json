{
  "info": {
    "_postman_id": "news-rag-api-collection-v2",
    "name": "News RAG API (Complete)",
    "description": "Comprehensive test collection for News RAG API including Core features, Validation, and Rate Limiting checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Core API",
      "item": [
        {
          "name": "Trigger Ingestion",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ingest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ingest"]
            },
            "description": "Triggers the background job to ingest news articles into Qdrant."
          },
          "response": []
        },
        {
          "name": "Chat (Valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has answer\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('answer');",
                  "    pm.expect(jsonData.sources).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"session_id\": \"{{sessionId}}\",\n    \"query\": \"What are the latest advancements in AI medicine?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            },
            "description": "Standard chat request with a valid session ID and query."
          },
          "response": []
        },
        {
          "name": "Get History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"History is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.history).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history", "{{sessionId}}"]
            },
            "description": "Retrieves chat history for the current session."
          },
          "response": []
        },
        {
          "name": "Delete History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history", "{{sessionId}}"]
            },
            "description": "Clears Redis history and deletes Postgres logs for the session."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Validation Tests (Bonus)",
      "item": [
        {
          "name": "Chat - Missing Session ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Error message is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"Validation Error\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"This should fail\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            }
          },
          "response": []
        },
        {
          "name": "Chat - Invalid Query Type",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"session_id\": \"test-1\",\n    \"query\": 12345\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Rate Limiting Check",
      "item": [
        {
          "name": "Check Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rate Limit headers present\", function () {",
                  "    pm.response.to.have.header(\"RateLimit-Limit\");",
                  "    pm.response.to.have.header(\"RateLimit-Remaining\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/history/rate-limit-test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history", "rate-limit-test"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "postman-test-session",
      "type": "string"
    }
  ]
}
